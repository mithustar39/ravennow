# Copy to .env and fill in. Never commit .env.

# --- Core ---
RAVENNOW_ENV=development
RAVENNOW_APP_NAME=RavenNow
RAVENNOW_SCHOOL=carleton

# A long random string. Logins/sessions derive from this.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
RAVENNOW_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Defaults to a local SQLite file under ./data. For production set a Postgres URL:
# RAVENNOW_DB=postgresql+psycopg://user:pass@host:5432/ravennow
# RAVENNOW_DB=sqlite:///./data/ravennow.db

# --- CORS ---
# Comma-separated list. The extension posts from chrome-extension:// origins,
# so for local dev keep "*". Lock this down once you have a fixed site origin.
RAVENNOW_CORS_ORIGINS=*

# --- Branding / links shown on the landing page ---
RAVENNOW_SUPPORT_EMAIL=hello@ravennow.ca
# Set this when the extension is published to a browser store. Until then the
# site uses the no-store install flow at /install.
RAVENNOW_CHROME_STORE_URL=
RAVENNOW_GITHUB_URL=https://github.com/mithustar39/ravennow
RAVENNOW_EXTENSION_URL=https://github.com/mithustar39/ravennow/releases/latest/download/ravennow-extension.zip
RAVENNOW_INSTALLER_PS1_URL=https://raw.githubusercontent.com/mithustar39/ravennow/main/scripts/install-extension.ps1
RAVENNOW_INSTALLER_SH_URL=https://raw.githubusercontent.com/mithustar39/ravennow/main/scripts/install-extension.sh

# --- Admin / SEO ---
# Long random string. Required to read the feedback inbox via GET /api/v1/feedback
# (sent as the X-Admin-Token header). Leave empty to keep that endpoint closed.
RAVENNOW_ADMIN_TOKEN=
# Public origin of the deployed site, used by robots.txt and sitemap.xml.
# RAVENNOW_PUBLIC_URL=https://ravennow.example.com
