# Copy to .env and fill in. Never commit .env.

# --- Core ---
RAVENNOW_ENV=development
RAVENNOW_APP_NAME=RavenNow
RAVENNOW_SCHOOL=carleton

# A long random string. Logins/sessions derive from this.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
RAVENNOW_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Defaults to a local SQLite file under ./data. For production set a Postgres URL:
# RAVENNOW_DB=postgresql+psycopg://user:pass@host:5432/ravennow
# RAVENNOW_DB=sqlite:///./data/ravennow.db

# --- CORS ---
# Comma-separated list. The extension posts from chrome-extension:// origins,
# so for local dev keep "*". Lock this down once you have a fixed site origin.
RAVENNOW_CORS_ORIGINS=*

# --- Branding / links shown on the landing page ---
RAVENNOW_SUPPORT_EMAIL=hello@ravennow.ca
RAVENNOW_CHROME_STORE_URL=
RAVENNOW_GITHUB_URL=
